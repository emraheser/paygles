# === Database ===
# VPS varsayılanı PostgreSQL (docker-compose içindeki servis adı: postgres)
POSTGRES_DB=paygles
POSTGRES_USER=paygles
POSTGRES_PASSWORD=paygles
DATABASE_URL=postgresql+asyncpg://paygles:paygles@postgres:5432/paygles
# SQLite kullanmak istersen DATABASE_URL satırını boş bırakıp bunu aç:
# SQLITE_PATH=./paygles.db

# === Telegram Bot (sending notifications) ===
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-100xxxxx

# === Telegram Client (reading channels) ===
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef
TELETHON_STRING_SESSION=   # base64 string session (for cloud/container)

# === AI (OpenRouter — free models available) ===
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=google/gemma-3-27b-it:free
# AI_ENHANCED_MODE=true yaparsan backfill job, son kayıtları da AI ile tekrar gözden geçirir.
AI_ENHANCED_MODE=false
# Enhanced moddaki AI gözden geçirme penceresi (saat)
AI_ENHANCED_LOOKBACK_HOURS=24

# === CORS (comma-separated origins, * for all) ===
ALLOWED_ORIGINS=*
